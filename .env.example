# Suggestions go to pokirahelp@outlook.com via FormSubmit after email activation.
# No environment variables are required for that browser-based delivery path.
# Optionally use Resend instead, with a verified sending domain and a secret key:
# SUGGESTIONS_FROM_EMAIL="Pokira <suggestions@your-verified-domain.example>"
# RESEND_API_KEY=re_replace_with_secret_key
