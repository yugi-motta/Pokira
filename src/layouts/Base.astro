---
import { copy, pathFor, type Lang } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}
const { lang, title, description } = Astro.props;
const t = copy[lang];
const fullTitle = title ? `${title} — ${t.siteTitle}` : t.siteTitle;
const metaDescription = description || t.siteDescription;
const alternate = pathFor(lang === 'ja' ? 'en' : 'ja');
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f5f7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={lang === 'ja' ? 'en' : 'ja'} href={new URL(alternate, Astro.site).href} />
    <link rel="alternate" hreflang={lang} href={canonical.href} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href={pathFor(lang)} aria-label={t.siteTitle}>
          <svg class="brand-mark" viewBox="0 0 36 36" fill="none" aria-hidden="true">
            <rect x="5" y="7" width="22" height="28" rx="4.5" transform="rotate(-12 5 7)" fill="#e54b47" />
            <rect x="10" y="4" width="22" height="28" rx="4.5" fill="#1d1d1f" />
            <path d="M13.5 18h15" stroke="white" stroke-width="1.6" />
            <circle cx="21" cy="18" r="5.2" fill="#1d1d1f" stroke="white" stroke-width="1.6" />
            <circle cx="21" cy="18" r="1.8" fill="white" />
          </svg>
          <span class="wordmark-name">Pokira<span class="wordmark-dot">.</span></span>
        </a>
        <label class="search-wrap">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
          <span class="sr-only">{t.searchLabel}</span>
          <input id="artist-search" type="search" placeholder={t.search} autocomplete="off" />
          <kbd>/</kbd>
        </label>
        <nav class="language-nav" aria-label={t.language}>
          <a href={pathFor('ja')} lang="ja" aria-current={lang === 'ja' ? 'page' : undefined} data-lang="ja">日本語</a>
          <a href={pathFor('en')} lang="en" aria-current={lang === 'en' ? 'page' : undefined} data-lang="en">ENG</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <span>Pokira © {new Date().getFullYear()}</span>
        <p>{t.unofficial}</p>
      </footer>
    </div>
    <script is:inline>
      document.querySelectorAll('[data-lang]').forEach((link) => {
        link.addEventListener('click', () => localStorage.setItem('pokira-lang', link.dataset.lang));
      });
      if (location.pathname === '/' && localStorage.getItem('pokira-lang') === 'en') location.replace('/en/');
    </script>
  </body>
</html>
