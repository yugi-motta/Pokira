---
import { copy, pathFor, type Lang } from '../lib/i18n';
import '../styles/global.css';
import IllustratorSearchResults from '../components/IllustratorSearchResults.astro';
import AboutPokira from '../components/AboutPokira.astro';

interface Props {
  lang: Lang;
  wide?: boolean;
  title?: string;
  description?: string;
}
const { lang, title, description, wide = false } = Astro.props;
const t = copy[lang];
const fullTitle = title ? `${title} — ${t.siteTitle}` : t.siteTitle;
const metaDescription = description || t.siteDescription;
const pagePath = Astro.url.pathname.replace(/^\/en(?=\/)/, '');
const alternate = `${lang === 'ja' ? '/en' : ''}${pagePath}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f5f7" />
    <script is:inline>
      document.documentElement.classList.add('js');
      let savedTheme;
      try { savedTheme = localStorage.getItem('pokira-theme'); } catch {}
      const initialTheme = savedTheme === 'light' || savedTheme === 'dark' ? savedTheme : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = initialTheme;
      document.querySelector('meta[name="theme-color"]').content = initialTheme === 'dark' ? '#121214' : '#f5f5f7';
    </script>
    <link rel="icon" href="/pokira-logo-hiragana.png" type="image/png" />
    <meta name="description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" hreflang={lang === 'ja' ? 'en' : 'ja'} href={new URL(alternate, Astro.site).href} />
    <link rel="alternate" hreflang={lang} href={canonical.href} />
    <link rel="preconnect" href="https://www.pokemon-card.com" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class:list={["site-shell",wide && "site-shell--wide"]}>
      <header class="site-header">
        <a class="wordmark" href={pathFor(lang)} aria-label={t.siteTitle}>
          <img class="brand-logo" src="/pokira-logo-hiragana.png" width="2172" height="724" alt="" decoding="async" />
        </a>
        <form class="search-wrap" action={pathFor(lang)} method="get">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
          <label class="sr-only" for="artist-search">{t.searchLabel}</label>
          <input id="artist-search" name="q" type="search" placeholder={t.search} autocomplete="off" aria-controls={pagePath!=='/'?'illustrator-search-results':undefined} />
          <button class="search-clear" type="button" aria-label={t.clearSearch} hidden><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m6 6 8 8m0-8-8 8" /></svg></button>
          {pagePath!=='/' && <IllustratorSearchResults lang={lang} />}
        </form>
        <div class="site-menu">
          <button class="menu-toggle" type="button" aria-label={t.menu} aria-expanded="false" aria-controls="site-menu-panel">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path class="menu-line menu-line-top" d="M4 7h16" /><path class="menu-line menu-line-middle" d="M4 12h16" /><path class="menu-line menu-line-bottom" d="M4 17h16" /></svg>
          </button>
          <div id="site-menu-panel" class="menu-panel" hidden>
            <div class="menu-group">
              <span class="menu-label">{t.language}</span>
              <nav class="menu-options" aria-label={t.language}>
                <a href={pagePath} lang="ja" aria-current={lang === 'ja' ? 'page' : undefined} data-lang="ja">日本語</a>
                <a href={`/en${pagePath}`} lang="en" aria-current={lang === 'en' ? 'page' : undefined} data-lang="en">English</a>
              </nav>
            </div>
            <div class="menu-group">
              <span class="menu-label">{t.theme}</span>
              <div class="menu-options" role="group" aria-label={t.theme}>
                <button type="button" data-theme-choice="light" aria-pressed="true">{t.light}</button>
                <button type="button" data-theme-choice="dark" aria-pressed="false">{t.dark}</button>
              </div>
            </div>
            <div class="menu-actions">
            <button class="about-trigger" type="button" aria-haspopup="dialog" aria-controls="about-dialog"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6"/><circle cx="12" cy="7.5" r="1" fill="currentColor" stroke="none"/></svg>{t.about}</button>
            <button class="suggestion-trigger" type="button" aria-haspopup="dialog" aria-controls="suggestion-dialog"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 5h16v11H9l-5 4V5Z"/><path d="M8 9h8M8 12h5"/></svg>{t.suggestArtist}</button>
            </div>
          </div>
        </div>
      </header>
      <main><slot /></main>
      <footer class="site-footer">
        <span>{t.siteTitle} © {new Date().getFullYear()}</span>
        <p>{t.unofficial}</p>
      </footer>
    </div>
    <AboutPokira lang={lang} />
    <script is:inline>
      const menuButton = document.querySelector('.menu-toggle');
      const menuPanel = document.querySelector('#site-menu-panel');
      const closeMenu = () => {
        menuPanel.dataset.closing = 'true';
        setTimeout(() => { if (menuButton.getAttribute('aria-expanded') === 'false') menuPanel.hidden = true; delete menuPanel.dataset.closing; }, 160);
        menuButton.setAttribute('aria-expanded', 'false');
      };
      menuButton.addEventListener('click', () => {
        const willOpen = menuButton.getAttribute('aria-expanded') !== 'true';
        if (!willOpen) { closeMenu(); return; }
        delete menuPanel.dataset.closing;
        menuPanel.hidden = !willOpen;
        menuButton.setAttribute('aria-expanded', String(willOpen));
      });
      document.addEventListener('click', (event) => {
        if (!event.target.closest('.site-menu')) closeMenu();
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !menuPanel.hidden) { closeMenu(); menuButton.focus(); }
      });
      menuPanel.querySelectorAll('.suggestion-trigger,.about-trigger').forEach(button=>button.addEventListener('click', closeMenu));
      const syncTheme = () => {
        const dark = document.documentElement.dataset.theme === 'dark';
        document.querySelectorAll('[data-theme-choice]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.themeChoice === (dark ? 'dark' : 'light'))));
        document.querySelector('meta[name="theme-color"]').content = dark ? '#121214' : '#f5f5f7';
      };
      const deviceTheme = matchMedia('(prefers-color-scheme: dark)');
      let themePreference;
      try { themePreference = localStorage.getItem('pokira-theme'); } catch {}
      deviceTheme.addEventListener('change', event => {
        if (themePreference === 'light' || themePreference === 'dark') return;
        document.documentElement.dataset.theme = event.matches ? 'dark' : 'light';
        syncTheme();
      });
      syncTheme();
      document.querySelectorAll('[data-theme-choice]').forEach((button) => button.addEventListener('click', () => {
        const theme = button.dataset.themeChoice;
        themePreference = theme;
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('pokira-theme', theme); } catch {}
        syncTheme();
      }));
      document.querySelectorAll('[data-lang]').forEach((link) => link.addEventListener('click', () => {
        try { localStorage.setItem('pokira-lang', link.dataset.lang); } catch {}
      }));
      try { if (location.pathname === '/' && localStorage.getItem('pokira-lang') === 'en') location.replace('/en/'); } catch {}
    </script>
  </body>
</html>
