---
import { illustratorSearchText } from '../lib/illustrator-search';
import { artists } from '../lib/content';
import { copy, type Lang } from '../lib/i18n';
import { catalogFor, cardImage, artistPath } from '../lib/cards';
import SocialLinks from './SocialLinks.astro';
import SuggestionForm from './SuggestionForm.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
---
<section class="directory" aria-label={t.directory}>
  <h1 class="sr-only">{t.directory}</h1>
  <div id="artist-grid" class="artist-grid">
    {artists.map((artist, index) => {
      const cards = catalogFor(artist.id, lang).cards;
      const previews = cards.filter(card => card.image).slice(0, 5);
      const profile = artistPath(lang, artist.id);
      const search = illustratorSearchText(artist);
      return (
        <article id={artist.id} class="artist-entry" style={`--entry-delay:${Math.min(index, 8) * 90}ms`} data-search={search} data-profile={profile}>
          <div class="artist-content">
            <div class="artist-heading">
              <a class="artist-avatar-link" href={profile} aria-label={artist.name}>{artist.avatar ? <img class="artist-avatar" src={artist.avatar} width="54" height="54" alt="" loading="lazy" decoding="async" /> : <span class="artist-avatar artist-avatar--text" aria-hidden="true">{artist.name.slice(0, 1)}</span>}</a>
              <div class="artist-identity">
                <h2><a class="artist-profile-link" href={profile}>{artist.name}</a></h2>
                <SocialLinks artist={artist} lang={lang} />
              </div>
            </div>
            <div class="artist-artworks">
              {previews.map((card) => (
                <a href={profile} class="artwork-thumb" style={`aspect-ratio:${card.imageWidth || 600}/${card.imageHeight || 825}`} aria-label={`${artist.name} · ${card.name}`}><img src={cardImage(card)} width="245" height="337" alt={card.name} loading="lazy" decoding="async" /><span class="image-unavailable" aria-hidden="true">{card.name}</span></a>
              ))}
              {!previews.length && <a href={profile} class="catalog-empty">{cards.length ? t.noCatalogImages : t.noCatalogCards}</a>}
            </div>
          </div>
        </article>
      );
    })}
  </div>
  <p id="no-results" class="no-results" hidden>{t.noResults}</p>
  <div class="directory-suggestion"><button class="search-suggest" data-suggest type="button">{t.suggestArtist}<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4h12v9H8l-4 3V4Z"/><path d="M7 7h6M7 10h4"/></svg></button></div>
  <span id="result-count" class="sr-only" aria-live="polite">{artists.length}</span>
  <SuggestionForm lang={lang} />
</section>
<script>
  const input = document.querySelector<HTMLInputElement>('#artist-search');
  const count = document.querySelector<HTMLElement>('#result-count');
  const noResults = document.querySelector<HTMLElement>('#no-results');
  const cards = [...document.querySelectorAll<HTMLElement>('.artist-entry')];
  cards.forEach(card => card.addEventListener('click', event => {
    if ((event.target as HTMLElement).closest('a,button,input,select') || window.getSelection()?.toString()) return;
    if (card.dataset.profile) location.assign(card.dataset.profile);
  }));
  const strips = [...document.querySelectorAll<HTMLElement>('.artist-artworks, .artist-socials')];
  document.querySelectorAll<HTMLImageElement>('.artwork-thumb img').forEach((image) => {
    const thumb = image.parentElement;
    const settle = () => thumb?.classList.add(image.naturalWidth ? 'is-loaded' : 'is-error');
    if (image.complete) settle();
    else {
      image.addEventListener('load', settle, { once: true });
      image.addEventListener('error', settle, { once: true });
    }
  });
  const updateStrip = (strip: HTMLElement) => {
    strip.dataset.before = String(strip.scrollLeft > 2);
    strip.dataset.more = String(strip.scrollLeft + strip.clientWidth < strip.scrollWidth - 2);
  };
  strips.forEach((strip) => {
    updateStrip(strip);
    strip.addEventListener('scroll', () => updateStrip(strip), { passive: true });
  });
  const stripObserver = new ResizeObserver(() => strips.forEach(updateStrip));
  strips.forEach((strip) => stripObserver.observe(strip));
  window.addEventListener('resize', () => strips.forEach(updateStrip));
  requestAnimationFrame(() => requestAnimationFrame(() => {
    document.querySelector('.directory')?.classList.add('is-ready');
  }));
  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase().trim();
  const update = () => {
    const query = normalize(input?.value || '');
    let visible = 0;
    cards.forEach((card) => {
      const match = !query || query.split(/\s+/).every((word) => card.dataset.search?.includes(word));
      card.hidden = !match;
      if (match) visible++;
    });
    if (count) count.textContent = String(visible);
    if (noResults) noResults.hidden = visible !== 0;
    requestAnimationFrame(() => strips.forEach(updateStrip));
  };
  const clear = document.querySelector<HTMLButtonElement>('.search-clear');
  input?.addEventListener('input', () => { update(); if (clear) clear.hidden = !input.value; });
  if (input) { input.value = new URLSearchParams(location.search).get('q') || ''; if (clear) clear.hidden = !input.value; update(); }
  clear?.addEventListener('click', () => { if (input) { input.value = ''; update(); clear.hidden = true; input.focus(); } });
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement !== input && !['INPUT','TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName)) {
      event.preventDefault();
      input?.focus();
    }
  });
</script>
