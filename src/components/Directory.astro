---
import { artists, newest } from '../lib/content';
import { copy, pathFor, type Lang } from '../lib/i18n';
import PostEmbed from './PostEmbed.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
---
<section class="intro">
  <div class="eyebrow">POKÉMON TCG ILLUSTRATORS <span aria-hidden="true">/</span> INDEX</div>
  <h1>{t.directory}<span class="small-count">{String(artists.length).padStart(2, '0')}</span></h1>
  <p>{t.siteDescription}</p>
</section>
<section class="directory-controls" aria-label={t.directory}>
  <label class="search-wrap">
    <span class="sr-only">{t.searchLabel}</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8"/><path d="m16 16 5 5"/></svg>
    <input id="artist-search" type="search" placeholder={t.search} autocomplete="off" />
    <kbd>/</kbd>
  </label>
  <button id="sort-toggle" class="sort-toggle" type="button" aria-pressed="false"><span aria-hidden="true">↕</span> {t.sort}</button>
</section>
<div class="directory-heading"><span>{t.all}</span><span id="result-count">{String(artists.length).padStart(2, '0')}</span></div>
<div id="artist-grid" class="artist-grid">
  {artists.map((artist, index) => {
    const posts = newest(artist.announcements);
    const search = [artist.name, artist.romanizedName, artist.handle, ...posts.flatMap((p) => p.pokemon)].filter(Boolean).join(' ').normalize('NFKC').toLocaleLowerCase();
    return (
      <article class="artist-entry" data-search={search} data-name={artist.handle.toLowerCase()} data-order={index}>
        <a class="artist-link" href={pathFor(lang, artist.id)} aria-label={`${artist.name} @${artist.handle}`}>
          <div class="artist-preview">
            {posts.slice(0, 2).map((post) => (
              <div class="preview-piece"><PostEmbed artist={artist} post={post} lang={lang} compact /></div>
            ))}
          </div>
          <div class="artist-text">
            <div><h2>{artist.name}</h2><span class="artist-handle">@{artist.handle}</span></div>
            <span class="artist-arrow" aria-hidden="true">↗</span>
          </div>
          <div class="artist-tags">{posts.slice(0, 3).map((post) => <span>{post.pokemon.join(' · ')}</span>)}</div>
        </a>
      </article>
    );
  })}
</div>
<p id="no-results" class="no-results" hidden>{t.noResults}</p>
<script>
  const input = document.querySelector<HTMLInputElement>('#artist-search');
  const grid = document.querySelector<HTMLElement>('#artist-grid');
  const count = document.querySelector<HTMLElement>('#result-count');
  const noResults = document.querySelector<HTMLElement>('#no-results');
  const sort = document.querySelector<HTMLButtonElement>('#sort-toggle');
  const cards = [...document.querySelectorAll<HTMLElement>('.artist-entry')];
  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase().trim();
  const update = () => {
    const query = normalize(input?.value || '');
    let visible = 0;
    cards.forEach((card) => {
      const match = !query || query.split(/\s+/).every((word) => card.dataset.search?.includes(word));
      card.hidden = !match;
      if (match) visible++;
    });
    if (count) count.textContent = String(visible).padStart(2, '0');
    if (noResults) noResults.hidden = visible !== 0;
  };
  input?.addEventListener('input', update);
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement !== input && !['INPUT','TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName)) {
      event.preventDefault();
      input?.focus();
    }
  });
  sort?.addEventListener('click', () => {
    const active = sort.getAttribute('aria-pressed') !== 'true';
    sort.setAttribute('aria-pressed', String(active));
    cards.sort((a, b) => active
      ? (a.dataset.name || '').localeCompare(b.dataset.name || '')
      : Number(a.dataset.order) - Number(b.dataset.order));
    cards.forEach((card) => grid?.appendChild(card));
  });
</script>
