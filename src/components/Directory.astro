---
import { artists, newest } from '../lib/content';
import { copy, type Lang } from '../lib/i18n';
import SuggestionForm from './SuggestionForm.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = copy[lang];
---
<section class="directory" aria-label={t.directory}>
  <h1 class="sr-only">{t.directory}</h1>
  <div id="artist-grid" class="artist-grid">
    {artists.map((artist, index) => {
      const posts = newest(artist.announcements).sort((a, b) => Number(b.tweetId === artist.featuredTweetId) - Number(a.tweetId === artist.featuredTweetId));
      const previews: { media: { src: string; width: number; height: number } }[] = [
        ...artist.gallery.map((media) => ({ media })),
        ...posts.filter((post) => post.media.length || post.images.length)
          .map((post) => ({ media: post.images[0] || post.media[0] }))
      ];
      for (const post of posts) {
        for (const media of (post.images.length ? post.images.slice(1) : post.media.slice(1))) {
          if (previews.length >= 6) break;
          previews.push({ media });
        }
        if (previews.length >= 6) break;
      }
      const search = [artist.name, artist.japaneseName, artist.romanizedName, artist.handle, artist.instagram, ...posts.flatMap((post) => post.pokemon)].filter(Boolean).join(' ').normalize('NFKC').toLocaleLowerCase();
      return (
        <article id={artist.id} class="artist-entry" style={`--entry-delay:${Math.min(index, 8) * 35}ms`} data-search={search}>
          <div class="artist-content">
            <div class="artist-heading">
              {artist.avatar ? <img class="artist-avatar" src={artist.avatar} width="54" height="54" alt="" loading="lazy" decoding="async" /> : <span class="artist-avatar artist-avatar--text" aria-hidden="true">{artist.name.slice(0, 1)}</span>}
              <div class="artist-identity">
                <h2>{artist.name}</h2>
                <nav class="artist-socials" aria-label={`${artist.name} ${t.socialProfiles}`}>
                  {artist.handle && <a href={`https://x.com/${artist.handle}`} target="_blank" rel="noopener noreferrer" aria-label={`${artist.name} ${t.onX}: ${artist.handle}`}>
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.24 6.94Zm-1.29 19.5h2.04L6.48 3.24H4.29Z" /></svg>
                    <span>{artist.handle}</span>
                  </a>}
                  {artist.instagram && <a href={`https://www.instagram.com/${artist.instagram}/`} target="_blank" rel="noopener noreferrer" aria-label={`${artist.name} ${t.onInstagram}: ${artist.instagram}`}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5.5" /><circle cx="12" cy="12" r="4" /><circle cx="17.8" cy="6.3" r="1" fill="currentColor" stroke="none" /></svg>
                    <span>{artist.instagram}</span>
                  </a>}
                </nav>
              </div>
            </div>
            <div class="artist-artworks" aria-hidden="true">
              {previews.slice(0, 6).map(({ media }) => (
                <div class="artwork-thumb" style={`aspect-ratio:${media.width}/${media.height}`}><img src={media.src.startsWith('https://') ? `${media.src}?format=jpg&name=small` : media.src} width={media.width} height={media.height} alt="" loading="lazy" decoding="async" /></div>
              ))}
              {!previews.length && posts.slice(0, 6).map((post) => <div class="artwork-thumb artwork-thumb--text">{post.pokemon.join(' / ')}</div>)}
            </div>
          </div>
        </article>
      );
    })}
  </div>
  <p id="no-results" class="no-results" hidden>{t.noResults}</p>
  <span id="result-count" class="sr-only" aria-live="polite">{artists.length}</span>
  <SuggestionForm lang={lang} />
</section>
<script>
  const input = document.querySelector<HTMLInputElement>('#artist-search');
  const count = document.querySelector<HTMLElement>('#result-count');
  const noResults = document.querySelector<HTMLElement>('#no-results');
  const cards = [...document.querySelectorAll<HTMLElement>('.artist-entry')];
  const strips = [...document.querySelectorAll<HTMLElement>('.artist-artworks')];
  document.querySelectorAll<HTMLImageElement>('.artwork-thumb img').forEach((image) => {
    const thumb = image.parentElement;
    const settle = () => thumb?.classList.add(image.naturalWidth ? 'is-loaded' : 'is-error');
    if (image.complete) settle();
    else {
      image.addEventListener('load', settle, { once: true });
      image.addEventListener('error', settle, { once: true });
    }
  });
  const updateStrip = (strip: HTMLElement) => {
    strip.dataset.before = String(strip.scrollLeft > 2);
    strip.dataset.more = String(strip.scrollLeft + strip.clientWidth < strip.scrollWidth - 2);
  };
  strips.forEach((strip) => {
    updateStrip(strip);
    strip.addEventListener('scroll', () => updateStrip(strip), { passive: true });
  });
  window.addEventListener('resize', () => strips.forEach(updateStrip));
  const normalize = (value: string) => value.normalize('NFKC').toLocaleLowerCase().trim();
  const update = () => {
    const query = normalize(input?.value || '');
    let visible = 0;
    cards.forEach((card) => {
      const match = !query || query.split(/\s+/).every((word) => card.dataset.search?.includes(word));
      card.hidden = !match;
      if (match) visible++;
    });
    if (count) count.textContent = String(visible);
    if (noResults) noResults.hidden = visible !== 0;
  };
  const clear = document.querySelector<HTMLButtonElement>('.search-clear');
  input?.addEventListener('input', () => { update(); if (clear) clear.hidden = !input.value; });
  clear?.addEventListener('click', () => { if (input) { input.value = ''; update(); clear.hidden = true; input.focus(); } });
  document.addEventListener('keydown', (event) => {
    if (event.key === '/' && document.activeElement !== input && !['INPUT','TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName)) {
      event.preventDefault();
      input?.focus();
    }
  });
</script>
