---
import { copy, type Lang } from '../lib/i18n';

interface Props { lang: Lang; }
const t = copy[Astro.props.lang];
---
<dialog id="suggestion-dialog" class="suggestion-dialog" aria-labelledby="suggestion-title">
    <div class="suggestion-dialog-inner">
      <button class="suggestion-close" type="button" aria-label={t.closeSuggestion}>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m6 6 8 8m0-8-8 8" /></svg>
      </button>
      <h2 id="suggestion-title">{t.suggestArtist}</h2>
      <form id="suggestion-form" action="/api/suggestions" method="post"
    data-invalid-link={t.invalidXLink}
    data-link-mismatch={t.linkMismatch}
    data-sending={t.sendingSuggestion}
    data-sent={t.suggestionSent}
    data-unavailable={t.suggestionsUnavailable}
    data-failed={t.suggestionFailed}>
    <div class="suggestion-fields">
      <label>{t.yourName}<span>{t.optional}</span><input name="name" type="text" autocomplete="name" maxlength="120" /></label>
      <label>{t.yourEmail}<span>{t.optional}</span><input name="email" type="email" autocomplete="email" maxlength="254" /></label>
      <label>{t.artistXLink}<input name="artistUrl" type="url" inputmode="url" autocomplete="url" placeholder="https://x.com/artist" maxlength="500" required /></label>
      <label>{t.artistPostLink}<input name="tweetUrl" type="url" inputmode="url" placeholder="https://x.com/artist/status/…" maxlength="500" required /></label>
    </div>
    <label class="suggestion-trap" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    <div class="suggestion-actions"><button type="submit">{t.sendSuggestion} <span aria-hidden="true">↗</span></button><p id="suggestion-status" role="status" aria-live="polite"></p></div>
      </form>
    </div>
</dialog>
<script>
  const trigger = document.querySelector<HTMLButtonElement>('.suggestion-trigger');
  const dialog = document.querySelector<HTMLDialogElement>('#suggestion-dialog');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('.suggestion-close');
  const form = document.querySelector<HTMLFormElement>('#suggestion-form');
  const status = document.querySelector<HTMLElement>('#suggestion-status');
  const artistInput = form?.querySelector<HTMLInputElement>('[name="artistUrl"]');
  const tweetInput = form?.querySelector<HTMLInputElement>('[name="tweetUrl"]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  let previousOverflow = '';
  trigger?.addEventListener('click', () => {
    if (!dialog) return;
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    dialog.showModal();
  });
  const closeDialog = () => dialog?.close();
  closeButton?.addEventListener('click', closeDialog);
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeDialog(); });
  dialog?.addEventListener('close', () => {
    document.body.style.overflow = previousOverflow;
    document.querySelector<HTMLButtonElement>('.menu-toggle')?.focus();
  });
  const handleFrom = (value: string, post: boolean) => {
    try {
      const url = new URL(value.trim());
      if (url.protocol !== 'https:' || !['x.com', 'www.x.com', 'twitter.com', 'www.twitter.com'].includes(url.hostname.toLowerCase())) return null;
      const match = url.pathname.match(post ? /^\/([A-Za-z0-9_]{1,15})\/status\/\d{15,20}\/?$/ : /^\/([A-Za-z0-9_]{1,15})\/?$/);
      return match?.[1].toLowerCase() || null;
    } catch { return null; }
  };
  for (const field of [artistInput, tweetInput]) field?.addEventListener('input', () => field.setCustomValidity(''));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!artistInput || !tweetInput || !button || !status) return;
    status.textContent = '';
    const artistHandle = handleFrom(artistInput.value, false);
    const postHandle = handleFrom(tweetInput.value, true);
    if (!artistHandle) artistInput.setCustomValidity(form.dataset.invalidLink || '');
    if (!postHandle) tweetInput.setCustomValidity(form.dataset.invalidLink || '');
    else if (artistHandle && artistHandle !== postHandle) tweetInput.setCustomValidity(form.dataset.linkMismatch || '');
    if (!form.reportValidity()) return;
    button.disabled = true;
    status.textContent = form.dataset.sending || '';
    try {
      const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
      const result: { code?: string } = await response.json();
      if (response.ok && result.code === 'sent') {
        status.textContent = form.dataset.sent || '';
        form.reset();
      } else {
        status.textContent = result.code === 'unavailable' ? form.dataset.unavailable || '' : form.dataset.failed || '';
      }
    } catch {
      status.textContent = form.dataset.failed || '';
    } finally {
      button.disabled = false;
    }
  });
</script>
