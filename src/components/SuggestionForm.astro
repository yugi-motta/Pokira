---
import { copy, type Lang } from '../lib/i18n';
import { suggestionsFallback, suggestionAccessKey } from '../lib/suggestions-config';

interface Props { lang: Lang; }
const t = copy[Astro.props.lang];
---
<dialog id="suggestion-dialog" class="suggestion-dialog" aria-labelledby="suggestion-title">
    <div class="suggestion-dialog-inner">
      <button class="suggestion-close" type="button" aria-label={t.closeSuggestion}>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="m6 6 8 8m0-8-8 8" /></svg>
      </button>
      <h2 id="suggestion-title">{t.suggestArtist}</h2>
      <form id="suggestion-form" action="/api/suggestions" method="post"
    data-fallback={suggestionsFallback} data-email-key={suggestionAccessKey}
    data-invalid-link={t.invalidXLink}
    data-link-mismatch={t.linkMismatch}
    data-sending={t.sendingSuggestion}
    data-timed-out={t.contactTimedOut}
    data-sent={t.suggestionSent}
    data-unavailable={t.suggestionsUnavailable}
    data-failed={t.suggestionFailed}>
    <div class="suggestion-fields">
      <label>{t.yourName}<span>{t.optional}</span><input name="name" type="text" autocomplete="name" maxlength="120" /></label>
      <label>{t.yourEmail}<span>{t.optional}</span><input name="email" type="email" autocomplete="email" maxlength="254" /></label>
      <label>{t.artistXLink}<input name="illustratorName" type="text" autocomplete="off" maxlength="120" required /></label>
      <label>{t.artistPostLink}<input name="postUrl" type="url" inputmode="url" autocomplete="url" maxlength="500" required /></label>
    </div>
    <label class="suggestion-trap" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    <div class="suggestion-actions"><button type="submit">{t.sendSuggestion} <span aria-hidden="true">↗</span></button><p id="suggestion-status" role="status" aria-live="polite"></p></div>
      </form>
    </div>
</dialog>
<script>
  import { prepareEmailFields } from '../lib/email-transport';
  const triggers = document.querySelectorAll<HTMLButtonElement>('.suggestion-trigger,[data-suggest]');
  const dialog = document.querySelector<HTMLDialogElement>('#suggestion-dialog');
  const closeButton = dialog?.querySelector<HTMLButtonElement>('.suggestion-close');
  const form = document.querySelector<HTMLFormElement>('#suggestion-form');
  const status = document.querySelector<HTMLElement>('#suggestion-status');
  const artistInput = form?.querySelector<HTMLInputElement>('[name="illustratorName"]');
  const postInput = form?.querySelector<HTMLInputElement>('[name="postUrl"]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  let previousOverflow = '';
  let previousScroll = { left: 0, top: 0 };
  let lastTrigger:HTMLButtonElement|null=null;
  let openedWithKeyboard=false;
  let announceOnClose=false;
  const announceSuccess=()=>document.dispatchEvent(new Event('pokira:suggestion-sent'));
  triggers.forEach(trigger=>trigger.addEventListener('click', event => {
    if (!dialog || dialog.open) return;
    lastTrigger=trigger;
    openedWithKeyboard=event.detail===0;
    previousScroll = { left: window.scrollX, top: window.scrollY };
    // Safari does not always focus a tapped button. Give the native dialog a
    // nearby focus destination before it records the element to return to.
    trigger.focus({ preventScroll: true });
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    dialog.showModal();
  }));
  const closeDialog = () => {
    if (!dialog || dialog.dataset.closing) return;
    dialog.dataset.closing = 'true';
    setTimeout(() => { dialog.close(); delete dialog.dataset.closing; }, 180);
  };
  dialog?.addEventListener('cancel', (event) => { event.preventDefault(); closeDialog(); });
  closeButton?.addEventListener('click', closeDialog);
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) closeDialog(); });
  dialog?.addEventListener('close', () => {
    document.body.style.overflow = previousOverflow;
    const focusTarget=lastTrigger?.closest('#site-menu-panel')
      ? document.querySelector<HTMLButtonElement>('.menu-toggle') : lastTrigger;
    focusTarget?.focus({ preventScroll: true });
    if(!openedWithKeyboard)focusTarget?.blur();
    window.scrollTo({ ...previousScroll, behavior: 'instant' });
    if(announceOnClose){announceOnClose=false;announceSuccess();}
  });
  const socialLink = (value: string, post: boolean) => {
    try {
      const url = new URL(value.trim());
      if (url.protocol !== 'https:' || url.username || url.password || url.port) return null;
      const host = url.hostname.toLowerCase();
      if (['x.com', 'www.x.com', 'twitter.com', 'www.twitter.com', 'mobile.twitter.com'].includes(host)) {
        const match = url.pathname.match(post ? /^\/([A-Za-z0-9_]{1,15})\/status\/\d{15,20}\/?$/ : /^\/([A-Za-z0-9_]{1,15})\/?$/);
        return match ? { platform: 'x', handle: match[1].toLowerCase() } : null;
      }
      if (['instagram.com', 'www.instagram.com', 'm.instagram.com'].includes(host)) {
        if (post) return /^\/(?:p|reel|reels|tv)\/[A-Za-z0-9_-]{5,30}\/?$/.test(url.pathname) ? { platform: 'instagram' } : null;
        const match = url.pathname.match(/^\/((?!.*\.\.)(?!.*\.$)[A-Za-z0-9._]{1,30})\/?$/);
        return match && !['p', 'reel', 'reels', 'tv'].includes(match[1].toLowerCase()) ? { platform: 'instagram', handle: match[1].toLowerCase() } : null;
      }
      return null;
    } catch { return null; }
  };
  for (const field of [artistInput, postInput]) field?.addEventListener('input', () => field.setCustomValidity(''));
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!artistInput || !postInput || !button || !status || button.disabled) return;
    status.textContent = '';
    const post = socialLink(postInput.value, true);
    if (!post) postInput.setCustomValidity(form.dataset.invalidLink || '');
    if (!form.reportValidity()) return;
    button.disabled = true;
    status.textContent = form.dataset.sending || '';
    const controller = new AbortController();
    const deadline = setTimeout(() => controller.abort(), 30_000);
    try {
      const fields=new FormData(form);
      let response = await fetch(form.action, { method: 'POST', body: fields, headers: { Accept: 'application/json' }, signal: controller.signal });
      let result: { code?: string } = await response.json();
      // Keep server validation before Web3Forms' browser-only free transport.
      if(((response.ok&&result.code==='forward')||(response.status===503&&result.code==='unavailable'))&&form.dataset.fallback){
        const deliveryFields = prepareEmailFields(fields, form.dataset.emailKey || '', `Pokira illustrator suggestion: ${artistInput.value}`, `${location.origin}${location.pathname}`);
        response=await fetch(form.dataset.fallback,{method:'POST',body:deliveryFields,headers:{Accept:'application/json'},signal:controller.signal});
        const delivered:{success?:boolean}=await response.json();
        result={code:response.ok&&delivered.success===true?'sent':'failed'};
      }
      if (response.ok && result.code === 'sent') {
        status.textContent = '';
        form.reset();
        if(dialog?.open){announceOnClose=true;closeDialog();}else announceSuccess();
      } else {
        status.textContent = result.code === 'unavailable' ? form.dataset.unavailable || '' : form.dataset.failed || '';
      }
    } catch {
      status.textContent = controller.signal.aborted ? form.dataset.timedOut || form.dataset.failed || '' : form.dataset.failed || '';
    } finally {
      clearTimeout(deadline);
      button.disabled = false;
    }
  });
</script>
