---
import type { Artist } from '../lib/schema';
import { catalogFor, PAGE_SIZE } from '../lib/cards';
import { copy, type Lang } from '../lib/i18n';
import SocialLinks from './SocialLinks.astro';
import SuggestionForm from './SuggestionForm.astro';
import GalleryCard from './GalleryCard.astro';
interface Props { artist: Artist; lang: Lang; }
const { artist, lang } = Astro.props;
const t = copy[lang];
const catalog = catalogFor(artist.id, lang);
const cards = catalog.cards;
const pokemonLabels=[...new Map(cards.flatMap(c=>(c.pokemon||[]).map(p=>[p.id,p.name] as const)))].sort((a,b)=>a[1].localeCompare(b[1],lang));
const setLabels = new Map<string, Set<string>>();
for(const card of cards){if(!setLabels.has(card.setId))setLabels.set(card.setId,new Set());setLabels.get(card.setId)!.add(card.setName);}
---
<section class="illustrator-profile" data-artist={artist.id} data-lang={lang} data-source-lang={catalog.language} data-version={catalog.version} data-count-label={t.cardCount} data-count-singular={t.cardCountSingular} data-failed={t.loadFailed}>
  <header class="profile-header">
    {artist.avatar ? <img class="artist-avatar profile-avatar" src={artist.avatar} width="76" height="76" alt="" decoding="async" /> : <span class="artist-avatar artist-avatar--text profile-avatar">{artist.name.slice(0,1)}</span>}
    <div class="profile-identity">
      <h1>{artist.name}</h1>
      <SocialLinks artist={artist} lang={lang} />
      <p class="profile-count">{cards.length.toLocaleString(lang)} {cards.length===1?t.cardCountSingular:t.cardCount}</p>
    </div>
  </header>
  <h2 class="sr-only">{t.cardsHeading}</h2>
  <form class="gallery-controls" role="search">
    <label class="sr-only" for="card-query">{t.searchCards}</label><input id="card-query" type="search" placeholder={t.searchCards} autocomplete="off" />
    <label class="sr-only" for="card-pokemon">{t.allPokemon}</label><select id="card-pokemon"><option value="">{t.allPokemon}</option>{pokemonLabels.map(([id,name])=><option value={id}>{name}</option>)}</select>
    <label class="sr-only" for="card-set">{t.allSets}</label><select id="card-set"><option value="">{t.allSets}</option>{[...setLabels.entries()].map(([id,names])=><option value={id}>{[...names].join(' / ')}</option>)}</select>
    <label class="sr-only" for="card-rarity">{t.allRarities}</label><select id="card-rarity"><option value="">{t.allRarities}</option>{[...new Set(cards.map(c=>c.rarity).filter(Boolean))].sort().map(rarity=><option value={rarity}>{rarity}</option>)}</select>
    <label class="sr-only" for="card-order">{t.orderCards}</label><select id="card-order"><option value="newest">{t.newestCards}</option><option value="oldest">{t.oldestCards}</option><option value="pokemon">{t.pokemonOrder}</option><option value="name">{t.nameOrder}</option><option value="number">{t.numberOrder}</option></select>
  </form>
  <div class="gallery-display" role="group" aria-label={t.displayCards}>
    {[["name",t.nameLabel,t.showName],["set",t.setLabel,t.showSet],["pocket",t.pocketLabel,t.showPocket]].map(([key,label,title])=><button type="button" class="display-toggle" data-display={key} aria-pressed="true" aria-label={title} title={title}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8 3 3 7-7"/></svg>{label}</button>)}
  </div>
  <div class="card-gallery" id="card-gallery" aria-label={`${artist.name} · ${t.cardsHeading}`}>
    {cards.slice(0, PAGE_SIZE).map(card => <GalleryCard card={card} lang={lang} />)}
  </div>
  {!cards.length && <p class="no-results">{t.noCatalogCards}</p>}
  <div class="gallery-pagination">
    {cards.length > PAGE_SIZE && <button class="load-more" type="button" data-page="2" data-loading={t.loadingCards} data-idle={t.loadMore} data-failed={t.loadFailed} data-unavailable={t.unavailableImage}>{t.loadMore}</button>}
    <p class="gallery-status" role="status" aria-live="polite"></p>
  </div>
  <p class="catalog-attribution">{catalog.source && <><a href={catalog.source} target="_blank" rel="noopener noreferrer">The Art of Pokémon</a> · </>}<a href="https://tcgdex.dev/" target="_blank" rel="noopener noreferrer">TCGdex</a> · <a href="https://www.pokemon-card.com/card-search/" target="_blank" rel="noopener noreferrer">Pokémon</a></p>
  <dialog tabindex="-1" class="card-viewer" aria-label={t.closeCard}>
    <div class="viewer-content">
      <div class="viewer-image-wrap"><img class="viewer-preview" alt="" /><img class="viewer-image" alt="" /></div>
      <div class="viewer-details">
        <p><svg viewBox="0 0 20 20" aria-hidden="true"><rect x="3" y="2" width="11" height="15" rx="2"/><path d="M7 5h4M7 8h4m6-3v11a3 3 0 0 1-3 3"/></svg><span class="viewer-set"></span></p>
        <p><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m4 12-1 5 5-1L17 7l-4-4Zm7-7 4 4"/></svg><span class="viewer-credit"></span><span class="viewer-date"></span></p>
      </div>
    </div>
  </dialog>
  <SuggestionForm lang={lang} />
</section>
<script>
  import '../lib/profile-client';
</script>
