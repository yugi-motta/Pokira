---
import type { Artist } from '../lib/schema';
import { catalogFor } from '../lib/cards';
import { copy, type Lang } from '../lib/i18n';
import SocialLinks from './SocialLinks.astro';
import SuggestionForm from './SuggestionForm.astro';
import GalleryCard from './GalleryCard.astro';
interface Props { artist: Artist; lang: Lang; }
const { artist, lang } = Astro.props;
const t = copy[lang];
const catalog = catalogFor(artist.id, lang);
const cards = catalog.cards;
---
<section class="illustrator-profile" data-artist={artist.id} data-lang={lang}>
  <header class="profile-header">
    {artist.avatar ? <img class="artist-avatar profile-avatar" src={artist.avatar} width="400" height="400" alt="" decoding="async" fetchpriority="high" /> : <span class="artist-avatar artist-avatar--text profile-avatar">{artist.name.slice(0,1)}</span>}
    <div class="profile-identity">
      <h1>{artist.name}</h1>
      <SocialLinks artist={artist} lang={lang} />
    </div>
  </header>
  <h2 class="sr-only">{t.cardsHeading}</h2>
  {cards.length ? <div class="gallery-preview">
    <div class="card-gallery" id="card-gallery" aria-label={`${artist.name} · ${t.cardsHeading}`}>
      {cards.map(card => <GalleryCard card={card} lang={lang} />)}
    </div>
    <a class="see-all" href={catalog.source} target="_blank" rel="noopener noreferrer" aria-label={t.seeAllLabel.replace('{name}',artist.name)}>{t.seeAll}<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M6 14 14 6M6 6h8v8"/></svg></a>
  </div> : <div class="preview-empty"><p>{t.noCatalogCards}</p><a class="see-all" href={catalog.source} target="_blank" rel="noopener noreferrer">{t.seeAll}</a></div>}
  <dialog tabindex="-1" class="card-viewer" aria-label={t.closeCard}>
    <div class="viewer-content">
      <div class="viewer-image-wrap"><img class="viewer-preview" alt="" draggable="false" /><img class="viewer-image" alt="" draggable="false" /><span class="artwork-glare" aria-hidden="true"></span></div>
    </div>
  </dialog>
  <SuggestionForm lang={lang} />
</section>
<script>
  import '../lib/profile-client';
</script>
