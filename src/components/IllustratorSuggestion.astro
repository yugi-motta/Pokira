---
import { copy, type Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const t = copy[Astro.props.lang];
---
<article class="artist-entry suggestion-card" style="--entry-delay:720ms">
  <div class="artist-content">
    <div class="artist-heading">
      <span class="artist-avatar suggestion-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span>
      <div class="artist-identity">
        <h2>{t.suggestArtist}</h2>
        <div class="suggestion-card-action"><button class="search-suggest" data-suggest type="button" aria-haspopup="dialog" aria-controls="suggestion-dialog">{t.suggestionAction}<svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4h12v9H8l-4 3V4Z"/><path d="M7 7h6M7 10h4"/></svg></button></div>
      </div>
    </div>
    <div class="artist-artworks suggestion-artworks" role="img" aria-label={t.suggestionPreview}>
      {Array.from({ length: 5 }, () => <span class="suggestion-artwork" aria-hidden="true"></span>)}
    </div>
  </div>
</article>
