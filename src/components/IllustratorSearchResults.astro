---
import { artists } from '../lib/content';
import { artistPath } from '../lib/cards';
import { illustratorSearchText } from '../lib/illustrator-search';
import { copy, type Lang } from '../lib/i18n';
interface Props { lang: Lang; }
const {lang}=Astro.props;
const t=copy[lang];
---
<nav id="illustrator-search-results" class="search-sheet" aria-label={t.searchLabel} hidden>
  <p class="search-sheet-empty" role="status" hidden>{t.noResults}</p>
  <ul>{artists.map(artist=><li data-search={illustratorSearchText(artist)} hidden><a href={artistPath(lang,artist.id)}>{artist.avatar?<img src={artist.avatar} width="34" height="34" alt="" loading="lazy"/>:<span class="search-result-avatar">{artist.name.slice(0,1)}</span>}<span><strong>{artist.name}</strong><small>{[artist.handle,artist.instagram].filter(Boolean).filter((handle,index,all)=>all.indexOf(handle)===index).join(' · ')}</small></span></a></li>)}
    <li class="search-suggestion-row" hidden>
      <button class="search-suggest" data-home-search-suggest type="button" aria-haspopup="dialog" aria-controls="suggestion-dialog">
        <span class="search-result-avatar suggestion-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span>
        <span><strong>{t.suggestArtist}</strong><small>{t.searchSuggestHint}</small></span>
      </button>
    </li>
  </ul>
</nav>
